$ORIGIN 15.168.192.in-addr.arpa.
$TTL 86400
@   IN  SOA ns1.omnisoc.local. admin.omnisoc.local. (
            2026110301 ; Serial
            3600       ; Refresh
            900        ; Retry
            604800     ; Expire
            86400 )    ; Negative Cache TTL
;
@   IN  NS  ns1.omnisoc.local.
122 IN  PTR ns1.omnisoc.local.
