$ORIGIN laboratorio.local.
$TTL 86400
@   IN  SOA ns1.laboratorio.local. admin.laboratorio.local. (
            2026100701 ; Serial (Formato: YYYYMMDDNN)
            3600       ; Refresh
            900        ; Retry
            604800     ; Expire
            86400 )    ; Negative Cache TTL
;
@   IN  NS  ns1.laboratorio.local.
ns1 IN  A   192.168.1.50
