key "kea-bind-key" {
	algorithm hmac-sha256;
	secret "n7lV700K4BJ3YgAcmBvRHTy9AD8sb9IDYivRoRFTNSA=";
};

// Zona de búsqueda directa
zone "omnisoc.local" {
    type master;
    file "/var/lib/bind/db.omnisoc.local";
    allow-update { key "kea-bind-key"; };
};

// Zona de búsqueda inversa (para la red 192.168.15.0/24)
zone "15.168.192.in-addr.arpa" {
    type master;
    file "/var/lib/bind/db.15.168.192";
    allow-update { key "kea-bind-key"; };
};

