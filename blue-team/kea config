{
"Dhcp4": {
    "interfaces-config": {
        "interfaces": [ "enp3s0" ] // Cambia 'enp3s0' por tu interfaz de red
    },

    "lease-database": {
        "type": "memfile",
        "persist": true,
        "name": "/var/lib/kea/dhcp4.leases"
    },

    "valid-lifetime": 86400, // Tiempo de concesión en segundos (24 horas)

    "subnet4": [
        {
            "subnet": "192.168.1.0/24",
            "pools": [
                { "pool": "192.168.1.100 - 192.168.1.200" } // Rango DHCP
            ],
            "option-data": [
                {
                    "name": "routers",
                    "data": "192.168.1.1" // Tu puerta de enlace
                },
                {
                    "name": "domain-name-servers",
                    "data": "192.168.1.50, 1.1.1.1" // IP de este servidor Ubuntu + DNS secundario
                },
                {
                    "name": "domain-name",
                    "data": "laboratorio.local"
                }
            ],
            "reservations": [
                {
                    "hw-address": "aa:bb:cc:dd:ee:ff",
                    "ip-address": "192.168.1.60",
                    "hostname": "nas-local"
                }
            ]
        }
    ]
}
}
