// Este archivo de configuración para definir la subred, el rango de IPs, reservas de IPs...
// Para aplicar cambios hacer este comando: sudo kea-dhcp4 -t -c /etc/kea/kea-dhcp4.conf

{
"Dhcp4": {
    "interfaces-config": {
        "interfaces": [ "enp0s3" ]
    },

    "lease-database": {
        "type": "memfile",
        "persist": true,
        "name": "/var/lib/kea/dhcp4.leases"
    },

    "valid-lifetime": 86400,

    "subnet4": [
        {
            "id": 1,
            "subnet": "192.168.15.0/24",
            "pools": [
                { "pool": "192.168.15.200 - 192.168.15.230" }
            ],
            "option-data": [
                { "name": "routers", "data": "192.168.15.10" },
                { "name": "domain-name-servers", "data": "192.168.15.122, 1.1.1.1" },
                { "name": "domain-name", "data": "omnisoc.local" }
            ],
            "reservations": [
                {
                    "hw-address": "08:00:27:ac:68:ac",
                    "ip-address": "192.168.15.165",
                    "hostname": "omni-cliente"
                },
                {
                    "hw-address": "08:00:27:5a:87:bc",
                    "ip-address": "192.168.15.164",
                    "hostname": "omni-kali"
                }
            ]
        }
    ]
}
}
