# Copia este fichero a .env y ajústalo. .env está en .gitignore: NUNCA lo subas al repo.

# --- General ---
DEMO_MODE=true                       # true = datos simulados realistas; false = fuentes reales
PANEL_PORT=8443                      # Apache ya usa 80/443 en omni-server
PANEL_HOSTNAME=omni-server.omnisoc.local
PANEL_IP=192.168.15.122
ALLOWED_ORIGINS=https://192.168.15.122:8443,https://omni-server.omnisoc.local:8443,https://localhost:8443

# --- Seguridad ---
# Si se dejan vacíos se generan solos: la clave se guarda en el volumen de datos y la
# contraseña inicial del admin se muestra UNA vez en `docker compose logs api`.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20

# --- Base de datos ---
# Vacío = SQLite en el volumen de datos (recomendado: omni-server va justo de RAM).
# PostgreSQL opcional: postgresql+asyncpg://usuario:clave@host:5432/omnisoc
DATABASE_URL=

# --- Recursos ---
API_MEM_LIMIT=256m
WEB_MEM_LIMIT=64m
EVENT_RETENTION_DAYS=30

# --- Métricas ---
SCORE_WEIGHTS=agents:20,vulnerabilities:20,hardening:20,alerts:20,coverage:20
ENABLED_CONNECTORS=wazuh,suricata,kea,dns,pfsense,services,github

# --- Wazuh (fase 2) ---
WAZUH_API_URL=https://192.168.15.122:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_INDEXER_URL=https://192.168.15.122:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_TLS=false

# --- Suricata / Kea (fase 2-3, montar los volúmenes en docker-compose.yml) ---
SURICATA_EVE_PATH=/var/log/suricata/eve.json
KEA_LEASES_PATH=/var/lib/kea/kea-leases4.csv
KEA_CONFIG_PATH=/etc/kea/kea-dhcp4.conf

# --- GitHub Projects (opcional, token de solo lectura) ---
GITHUB_TOKEN=
GITHUB_PROJECT_URL=
