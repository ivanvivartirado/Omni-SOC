alert icmp any any -> $HOME_NET any (msg:"PING detectado (ICMP echo request)"; itype:8; sid:1000001; rev:2;)
alert tcp any any -> $HOME_NET any (msg:"OMNI-SOC Posible escaneo de puertos (SYN)"; flags:S,12; threshold: type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)
